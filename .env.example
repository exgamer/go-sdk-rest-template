APP_NAME=rest-template
APP_ENV=local
APP_VERSION=1.0
TIMEZONE=
LOG_LEVEL=DEBUG

SERVER_ADDRESS=0.0.0.0:8090
SWAGGER_PREFIX=swagger
SWAGGER_ENABLED=true
# Текст паники и стек в ответе 500 (с gosdk-http-core v1.2.0): true | 1 — включено; пусто или любое другое — выключено. На проде не задавать
HTTP_ERROR_DETAILS=
HANDLER_TIMEOUT=30
SENTRY_DSN=

POSTGRES_DB_HOST=localhost
POSTGRES_DB_USER=admin
POSTGRES_DB_PASSWORD=admin
POSTGRES_DB_NAME=test
POSTGRES_DB_PORT=5432
POSTGRES_DB_MAX_OPEN_CONNECTIONS=100
POSTGRES_DB_MAX_IDLE_CONNECTIONS=10